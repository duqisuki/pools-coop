<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test runner for the pure-.NET net layer. No game, no Unity, no NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>11.0</LangVersion>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>PoolsCoop.Tests</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PoolsCoop\Net\*.cs" Link="Net\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\PoolsCoop\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

